# Flask configuration
FLASK_ENV=development
DEBUG=False
PORT=5001

# CORS — space-separated list of allowed origins.
# In production set this to your actual frontend URL, e.g.:
#   CORS_ORIGINS=https://your-frontend.com
CORS_ORIGINS=http://localhost:5173 http://localhost:8080 http://localhost:8081 http://localhost:8082

# Optional: max audio clip length in seconds
MAX_AUDIO_LENGTH=30

# Security
# Set to true to require X-API-Key for all API routes except /api/health
API_AUTH_ENABLED=true
API_SHARED_KEY=dev-local-change-this-key

# Request and rate-limit controls
MAX_CONTENT_LENGTH=5242880
GLOBAL_RATE_LIMIT=120 per minute
RATE_LIMIT_STORAGE_URI=memory://

# Enable only when deployed behind HTTPS
ENABLE_HSTS=false
